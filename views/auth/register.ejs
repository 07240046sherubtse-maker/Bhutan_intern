<%- include('../partials/header', { title }) %>
<section class="auth-wrap"><div class="auth-aside"><span class="eyebrow eyebrow-light">Start with possibility</span><h1>Make room for what comes next.</h1><p>Create a profile to explore internships, apply and follow your progress in one place.</p></div>
  <div class="auth-card auth-card-wide"><span class="eyebrow">Your account</span><h2>Create your account</h2><p class="muted">A few details are all you need to get started. We’ll email you a six-digit code to verify your address.</p>
    <form method="post" action="/register" class="form-grid">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="span-two">Full name<span class="auth-input-wrap"><svg class="auth-field-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="4"></circle><path d="M5 21a7 7 0 0 1 14 0"></path></svg><input name="name" autocomplete="name" required minlength="2" maxlength="120"></span></label>
      <label>Email address<span class="auth-input-wrap"><svg class="auth-field-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg><input name="email" type="email" autocomplete="email" required maxlength="254"></span></label>
      <label>Phone number<span class="auth-input-wrap"><svg class="auth-field-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 3H4a1 1 0 0 0-1 1 17 17 0 0 0 17 17 1 1 0 0 0 1-1v-3l-5-2-2 2a13 13 0 0 1-8-8l2-2z"></path></svg><input name="phone" type="tel" autocomplete="tel" required maxlength="40"></span></label>
      <label>Password<span class="auth-input-wrap"><svg class="auth-field-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="4" y="10" width="16" height="11" rx="2"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3"></path></svg><input name="password" type="password" autocomplete="new-password" required minlength="10" maxlength="128"></span><small>Use at least 10 characters.</small></label>
      <label>Confirm password<span class="auth-input-wrap"><svg class="auth-field-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="4" y="10" width="16" height="11" rx="2"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3"></path></svg><input name="confirmPassword" type="password" autocomplete="new-password" required minlength="10" maxlength="128"></span></label>
      <button class="button button-primary button-wide span-two" type="submit">Create account <span>→</span></button>
    </form><p class="auth-switch">Already registered? <a href="/login">Sign in</a></p>
  </div>
</section>
<%- include('../partials/footer') %>
