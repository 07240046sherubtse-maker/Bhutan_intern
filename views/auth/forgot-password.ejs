<%- include('../partials/header', { title }) %>
<section class="auth-wrap"><div class="auth-aside"><span class="eyebrow eyebrow-light">Account recovery</span><h1>A fresh start is one email away.</h1><p>We will send a secure, time-limited six-digit reset code if the account exists.</p></div>
  <div class="auth-card"><span class="eyebrow">Reset password</span><h2>Forgot your password?</h2><p class="muted">Enter the email address associated with your account.</p>
    <form method="post" action="/forgot-password" class="form-stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Email address<span class="auth-input-wrap"><svg class="auth-field-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg><input name="email" type="email" autocomplete="email" required maxlength="254"></span></label>
      <button class="button button-primary button-wide" type="submit">Send reset code</button>
    </form><p class="auth-switch"><a href="/login">Return to sign in</a></p>
  </div>
</section>
<%- include('../partials/footer') %>
