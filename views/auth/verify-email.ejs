<%- include('../partials/header', { title }) %>
<section class="auth-wrap"><div class="auth-aside"><span class="eyebrow eyebrow-light">One last step</span><h1>Confirm your email address.</h1><p>Enter the six-digit code we sent to your email. The code expires in 10 minutes.</p></div>
  <div class="auth-card"><span class="eyebrow">Email verification</span><h2>Verify your account</h2><p class="muted">Enter the code from your email to continue.</p>
    <form method="post" action="/verify-email" class="form-stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Email address<span class="auth-input-wrap"><svg class="auth-field-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg><input name="email" type="email" autocomplete="email" required maxlength="254" value="<%= email %>"></span></label>
      <label>Six-digit code<span class="auth-input-wrap"><svg class="auth-field-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11z"></path><path d="m9 12 2 2 4-4"></path></svg><input name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" minlength="6" maxlength="6" required></span></label>
      <button class="button button-primary button-wide" type="submit">Verify email</button>
    </form>
  </div>
</section>
<%- include('../partials/footer') %>
