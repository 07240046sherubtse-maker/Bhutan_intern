<%- include('../partials/header', { title }) %>
<section class="auth-wrap"><div class="auth-aside"><span class="eyebrow eyebrow-light">Account recovery</span><h1>Choose a new password.</h1><p>Your six-digit reset code expires after 15 minutes and can only be used once.</p></div>
  <div class="auth-card"><span class="eyebrow">Reset password</span><h2>Set a new password</h2>
    <form method="post" action="/reset-password" class="form-stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Email address<span class="auth-input-wrap"><svg class="auth-field-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg><input name="email" type="email" autocomplete="email" required maxlength="254" value="<%= email %>"></span></label>
      <label>Six-digit reset code<span class="auth-input-wrap"><svg class="auth-field-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11z"></path><path d="m9 12 2 2 4-4"></path></svg><input name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" minlength="6" maxlength="6" required></span></label>
      <label>New password<span class="auth-input-wrap"><svg class="auth-field-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="4" y="10" width="16" height="11" rx="2"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3"></path></svg><input name="password" type="password" autocomplete="new-password" minlength="10" maxlength="128" required></span><small>Use at least 10 characters.</small></label>
      <label>Confirm new password<span class="auth-input-wrap"><svg class="auth-field-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="4" y="10" width="16" height="11" rx="2"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3"></path></svg><input name="confirmPassword" type="password" autocomplete="new-password" minlength="10" maxlength="128" required></span></label>
      <button class="button button-primary button-wide" type="submit">Update password</button>
    </form>
  </div>
</section>
<%- include('../partials/footer') %>
