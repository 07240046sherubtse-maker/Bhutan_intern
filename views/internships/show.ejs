<%- include('../partials/header', { title }) %>
<section class="detail-wrap"><a class="back-link" href="/internships">← Back to internships</a><div class="detail-heading"><div><span class="tag"><%= internship.internship_type.replace('-', ' ') %></span><h1><%= internship.title %></h1><p class="company-line"><a href="/companies/<%= internship.company_id %>"><%= internship.company_name %></a></p></div>
  <% if (currentUser && currentUser.role === 'user') { %><% if (applied) { %><span class="button button-disabled">Application submitted</span><% } else { %><a class="button button-primary" href="/internships/<%= internship.id %>/apply">Apply now <span>→</span></a><% } %><% } else { %><a class="button button-primary" href="/login">Sign in to apply <span>→</span></a><% } %>
</div>
<div class="detail-grid"><article class="content-panel"><span class="eyebrow">About this opportunity</span><div class="prose"><p><%= internship.description %></p></div>
  <h2>What you need</h2><p><%= internship.qualifications || 'See the role description or contact the platform administrator for details.' %></p><h2>Skills</h2><p><%= internship.skills || 'Not specified' %></p><h2>Documents to prepare</h2><p><%= internship.required_documents || 'CV / resume' %></p>
</article><aside class="content-panel detail-facts"><span class="eyebrow">Opportunity details</span><dl><div><dt>Organisation</dt><dd><%= internship.company_name %></dd></div><div><dt>Category</dt><dd><%= internship.category %></dd></div><div><dt>Location</dt><dd><%= internship.location || internship.dzongkhag || 'Bhutan' %></dd></div><div><dt>Arrangement</dt><dd><%= internship.work_arrangement %></dd></div><div><dt>Duration</dt><dd><%= internship.duration || 'To be confirmed' %></dd></div><div><dt>Working hours</dt><dd><%= internship.working_hours || 'To be confirmed' %></dd></div><div><dt>Monthly allowance</dt><dd><%= internship.stipend_nu ? `Nu. ${Number(internship.stipend_nu).toLocaleString("en-GB")}` : 'Not specified' %></dd></div><div><dt>Apply by</dt><dd><%= internship.deadline ? new Date(internship.deadline).toLocaleDateString("en-GB") : 'Open until filled' %></dd></div></dl></aside></div>
<%- include('../partials/footer') %>
