<%- include('../partials/header', { title }) %>
<section class="dashboard-head"><div><span class="eyebrow">Your information</span><h1>My profile</h1><p>Keep your details up to date for future applications.</p></div></section>
<form class="content-panel form-grid profile-form" method="post" action="/profile"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <label>Full name<input name="name" value="<%= profile.name %>" required maxlength="120"></label><label>Email<input name="email" type="email" value="<%= profile.email %>" required maxlength="254"><small><%= profile.email_verified_at ? 'Verified email address.' : 'Email address not verified.' %> Changing email requires your current password.</small></label><label>Phone number<input name="phone" type="tel" value="<%= profile.phone %>" required maxlength="40"></label><label>Current password (only required to change email)<input name="current_password" type="password" autocomplete="current-password"></label><label>Date of birth<input class="date-dmy" name="date_of_birth" type="text" value="<%= toDateInputValue(profile.date_of_birth) %>" placeholder="DD/MM/YYYY" inputmode="numeric" pattern="\d{2}/\d{2}/\d{4}" aria-label="Date of birth (DD/MM/YYYY)"></label>
  <label>Gender (optional)<select name="gender"><option value="">Prefer not to say</option><% ['Female','Male','Other'].forEach((value) => { %><option <%= profile.gender===value?'selected':'' %>><%= value %></option><% }) %></select></label>
  <label>Dzongkhag<input name="dzongkhag" value="<%= profile.dzongkhag || '' %>" maxlength="100"></label><label>Gewog<input name="gewog" value="<%= profile.gewog || '' %>" maxlength="100"></label><label>Highest qualification<input name="education" value="<%= profile.education || '' %>" maxlength="200"></label><label>Institution<input name="institution" value="<%= profile.institution || '' %>" maxlength="200"></label><label>Field of study<input name="field_of_study" value="<%= profile.field_of_study || '' %>" maxlength="200"></label><label>Internship preference<select name="preference"><% ['','short-term','long-term','vacation','part-time','full-time','any'].forEach((value) => { %><option value="<%= value %>" <%= profile.preference===value?'selected':'' %>><%= value ? value.replace('-', ' ') : 'Select preference' %></option><% }) %></select></label><label class="span-two">Current address<textarea name="address" rows="3" maxlength="1000"><%= profile.address || '' %></textarea></label><button class="button button-primary span-two" type="submit">Save profile</button>
</form>
<% if (!profile.email_verified_at) { %><form method="post" action="/email/verification/resend" class="content-panel form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="email" value="<%= profile.email %>"><p>Verify your email address to enable sign-in with this address.</p><button class="button button-secondary" type="submit">Resend verification email</button></form><% } %>
<%- include('../partials/footer') %>
