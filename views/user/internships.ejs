<%- include('../partials/header', { title }) %><section class="dashboard-head"><div><span class="eyebrow">Your experience</span><h1>My internships</h1><p>An application approval is not a start date; your start is shown after the administrator confirms it.</p></div></section>
<% if(records.length){ %><div class="stack-list"><% records.forEach((record)=>{ %><article class="content-panel internship-record"><div class="panel-heading"><div><h2><%= record.title %></h2><p><%= record.company_name %> · <%= record.dzongkhag || 'Bhutan' %></p></div><span class="status status-<%= record.status %>"><%= record.status %></span></div><div class="record-dates"><span><small>Actual start</small><strong><%= record.actual_start_date ? new Date(record.actual_start_date).toLocaleDateString("en-GB") : 'Not confirmed' %></strong></span><span><small>Current end</small><strong><%= record.current_end_date ? new Date(record.current_end_date).toLocaleDateString("en-GB") : 'Not set' %></strong></span><span><small>Original end</small><strong><%= record.original_end_date ? new Date(record.original_end_date).toLocaleDateString("en-GB") : 'Not set' %></strong></span></div><% if(record.status==='active'){ %><a class="text-link" href="/extensions">Manage extension requests →</a><% } %></article><% }) %></div><% }else{ %><section class="empty-state"><h2>No internship records yet</h2><p>When an application is approved, it will appear here. The start date is recorded separately by an administrator.</p><a class="button button-primary" href="/applications">View applications</a></section><% } %>
<%- include('../partials/footer') %>
