<%- include('../partials/header', { title }) %><section class="dashboard-head"><div><span class="eyebrow">Keep growing</span><h1>Internship extensions</h1><p>Request more time for an approved, active internship. An extension takes effect only after administrator approval.</p></div></section>
<% if(records.length){ %><div class="stack-list"><% records.forEach((record) => { %><article class="content-panel extension-card"><div class="panel-heading"><div><h2><%= record.internship_title %></h2><p><%= record.company_name %></p></div><span class="status status-<%= record.request_status || record.internship_status %>"><%= record.request_status || record.internship_status %></span></div>
  <p class="muted">Current end date: <%= record.current_end_date ? formatDate(record.current_end_date) : 'Not set' %></p>
  <% if(record.request_id){ %><p><strong>Requested:</strong> <%= record.additional_duration %> · <%= formatDate(record.proposed_end_date) %></p><p><%= record.reason %></p><% if(record.admin_comment){ %><p class="form-notice"><%= record.admin_comment %></p><% } %><% } %><% if(record.internship_status==='active' && record.request_status!=='pending'){ %>
  <form method="post" action="/records/<%= record.record_id %>/extensions" class="form-grid extension-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Additional duration<input name="additional_duration" placeholder="e.g. 2 months" maxlength="100" required></label><label>Proposed new end date<input class="date-dmy" type="text" name="proposed_end_date" required placeholder="DD/MM/YYYY" inputmode="numeric" pattern="\d{2}/\d{2}/\d{4}" aria-label="Proposed new end date (DD/MM/YYYY)"></label><label class="span-two">Reason<textarea name="reason" rows="3" maxlength="3000" required></textarea></label><button class="button button-secondary span-two" type="submit">Request extension</button></form><% } %>
</article><% }) %></div><% }else{ %><div class="empty-state"><h2>No approved internship records yet</h2><p>Once an application is approved, its internship record and extension options will show here.</p></div><% } %>
<%- include('../partials/footer') %>
