<%- include('../partials/header', { title }) %><section class="dashboard-head"><div><span class="eyebrow">Private files</span><h1>My documents</h1><p>Files you included with internship applications.</p></div></section>
<section class="content-panel"><% if(documents.length){ %><div class="table-wrap"><table><thead><tr><th>Document</th><th>Internship</th><th>Uploaded</th><th></th></tr></thead><tbody><% documents.forEach((doc) => { %><tr><td><%= doc.original_name %><small class="table-note"><%= (doc.size_bytes/1024).toFixed(0) %> KB</small></td><td><%= doc.title %></td><td><%= new Date(doc.uploaded_at).toLocaleDateString("en-GB") %></td><td><a class="text-link" href="/documents/<%= doc.id %>">Download ↗</a></td></tr><% }) %></tbody></table></div><% }else{ %><div class="empty-inline"><p>No documents uploaded yet. You can add supporting documents when applying.</p><a href="/internships" class="text-link">Find internships →</a></div><% } %></section><%- include('../partials/footer') %>
