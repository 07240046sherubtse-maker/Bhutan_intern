<%- include('../partials/header', { title }) %><section class="dashboard-head"><div><span class="eyebrow">Your updates</span><h1>Notifications</h1><p>Application and internship updates, all in one place.</p></div></section>
<section class="content-panel"><% if(notifications.length){ %><div class="notification-list"><% notifications.forEach((item) => { %><article class="notification-item <%= item.read_at ? '' : 'unread' %>"><div><p><%= item.message %></p><small><%= new Date(item.created_at).toLocaleString("en-GB") %></small></div><div class="notification-actions"><% if(item.href){ %><a class="text-link" href="<%= item.href %>">Open →</a><% } %><% if(!item.read_at){ %><form method="post" action="/notifications/<%= item.id %>/read"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-small button-quiet">Mark read</button></form><% } %></div></article><% }) %></div><% }else{ %><div class="empty-inline"><p>You're all caught up. New updates will appear here.</p></div><% } %></section><%- include('../partials/footer') %>
