<%- include('../partials/header', { title }) %>
<section class="dashboard-head"><div><span class="eyebrow">Your activity</span><h1>My applications</h1><p>Follow each application and its latest status.</p></div><a class="button button-primary" href="/internships">Explore internships <span>→</span></a></section>
<section class="content-panel"><% if(applications.length){ %><div class="table-wrap"><table><thead><tr><th>Opportunity</th><th>Organisation</th><th>Contact phone</th><th>Submitted</th><th>Status</th><th>Action</th></tr></thead><tbody><% applications.forEach((application) => { %><tr><td><a href="/internships/<%= application.internship_id %>"><%= application.title %></a></td><td><%= application.company_name %></td><td><% if(application.company_phone){ %><a href="tel:<%= application.company_phone %>"><%= application.company_phone %></a><% }else{ %><span class="muted">Not provided</span><% } %></td><td><%= new Date(application.submitted_at).toLocaleDateString("en-GB") %></td><td><span class="status status-<%= application.status %>"><%= application.status %></span><% if(application.admin_notes){ %><small class="table-note"><%= application.admin_notes %></small><% } %></td><td><% if(application.status==='pending'){ %><div class="inline-actions"><a class="button button-small button-secondary" href="/applications/<%= application.id %>/edit">Edit</a><form method="post" action="/applications/<%= application.id %>/cancel" data-confirm="Cancel this application?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-small button-quiet" type="submit">Cancel</button></form></div><% }else{ %><span class="muted">—</span><% } %></td></tr><% }) %></tbody></table></div><% }else{ %><div class="empty-state"><h2>Your next opportunity is waiting</h2><p>When you apply, your applications and updates will appear here.</p><a class="button button-primary" href="/internships">Browse internships</a></div><% } %></section>
<%- include('../partials/footer') %>
