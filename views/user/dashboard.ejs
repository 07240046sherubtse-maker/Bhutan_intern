<%- include('../partials/header', { title }) %>
<section class="dashboard-head"><div><span class="eyebrow">Your progress</span><h1>Welcome back, <%= currentUser.name.split(' ')[0] %>.</h1><p>Keep an eye on your applications and what comes next.</p></div><a class="button button-primary" href="/internships">Find an internship <span>→</span></a></section>
<section class="stats-grid"><article class="stat-card"><span>Total applications</span><strong><%= counts.total %></strong><small>All submitted applications</small></article><article class="stat-card"><span>Pending</span><strong><%= counts.pending %></strong><small>Awaiting an update</small></article><article class="stat-card"><span>Approved</span><strong><%= counts.approved %></strong><small>Approved applications</small></article><article class="stat-card"><span>Declined</span><strong><%= counts.declined %></strong><small>Application decisions</small></article><article class="stat-card"><span>Active internships</span><strong><%= counts.active_internships %></strong><small>Start confirmed by administrator</small></article><article class="stat-card"><span>Extension requests</span><strong><%= counts.extension_requests %></strong><small>Total submitted requests</small></article></section>
<section class="dashboard-grid"><div class="content-panel"><div class="panel-heading"><div><span class="eyebrow">Stay up to date</span><h2>Recent applications</h2></div><a class="text-link" href="/applications">View all →</a></div>
  <% if(applications.length){ %><div class="table-wrap"><table><thead><tr><th>Opportunity</th><th>Organisation</th><th>Submitted</th><th>Status</th></tr></thead><tbody><% applications.forEach((application) => { %><tr><td><a href="/internships/<%= application.internship_id %>"><%= application.title %></a></td><td><%= application.company_name %></td><td><%= new Date(application.submitted_at).toLocaleDateString("en-GB") %></td><td><span class="status status-<%= application.status %>"><%= application.status %></span></td></tr><% }) %></tbody></table></div><% }else{ %><div class="empty-inline"><p>You haven't applied for an internship yet.</p><a class="text-link" href="/internships">Explore opportunities →</a></div><% } %>
</div><aside class="content-panel"><div class="panel-heading"><div><span class="eyebrow">Personal details</span><h2>Your profile</h2></div><a class="text-link" href="/profile">Edit →</a></div><p><strong><%= currentUser.name %></strong></p><p class="muted"><%= currentUser.email %></p><p class="muted"><%= profile?.dzongkhag || 'Add your location' %></p><hr><h3>Quick links</h3><div class="quick-links"><a href="/my-internships">My internships <span>→</span></a><a href="/documents">My documents <span>→</span></a><a href="/extensions">Extension requests <span>→</span></a><a href="/notifications">Notifications <span>→</span></a><a href="/settings">Account settings <span>→</span></a></div></aside></section>
<%- include('../partials/footer') %>
