<%- include('../partials/header', { title }) %>
<section class="form-page"><a class="back-link" href="<%= editing ? '/applications' : `/internships/${internship.id}` %>">← <%= editing ? 'Back to my applications' : 'Back to opportunity' %></a><div class="form-heading"><span class="eyebrow"><%= editing ? 'Update your application' : 'Application' %></span><h1><%= editing ? 'Edit application for ' : 'Apply for ' %><%= internship.title %></h1><p><%= internship.company_name %><%= editing ? '' : ` · ${internship.category}` %></p></div>
<form class="content-panel form-grid" method="post" enctype="multipart/form-data" action="<%= editing ? `/applications/${application.id}/edit` : `/internships/${internship.id}/apply` %>">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="span-two form-section-title"><h2>About you</h2><p>Review your information and fill in any missing details.</p></div>
  <label>Full name<input value="<%= profile.name %>" disabled></label><label>Email address<input value="<%= profile.email %>" disabled></label><label>Phone<input value="<%= profile.phone %>" disabled></label>
  <label>Date of birth<input class="date-dmy" name="date_of_birth" type="text" value="<%= toDateInputValue(editing ? application.date_of_birth : profile.date_of_birth) %>" placeholder="DD/MM/YYYY" inputmode="numeric" pattern="\d{2}/\d{2}/\d{4}" aria-label="Date of birth (DD/MM/YYYY)"></label>
  <label>Dzongkhag<input name="dzongkhag" value="<%= editing ? application.dzongkhag : profile.dzongkhag || '' %>" maxlength="100"></label><label class="span-two">Current address<textarea name="address" rows="2" maxlength="1000"><%= editing ? application.address : profile.address || '' %></textarea></label>
  <div class="span-two form-section-title"><h2>Education and experience</h2></div>
  <label>Highest qualification<input name="education" value="<%= editing ? application.education : profile.education || '' %>" maxlength="200"></label><label>Institution<input name="institution" value="<%= editing ? application.institution : profile.institution || '' %>" maxlength="200"></label><label>Field of study<input name="field_of_study" value="<%= editing ? application.field_of_study : profile.field_of_study || '' %>" maxlength="200"></label><label>Preferred starting date<input class="date-dmy" name="preferred_start_date" type="text" value="<%= toDateInputValue(editing ? application.preferred_start_date : '') %>" placeholder="DD/MM/YYYY" inputmode="numeric" pattern="\d{2}/\d{2}/\d{4}" aria-label="Preferred starting date (DD/MM/YYYY)"></label>
  <label class="span-two">Previous work or internship experience<textarea name="experience" rows="3" maxlength="4000"><%= editing ? application.experience : '' %></textarea></label><label class="span-two">Skills<textarea name="skills" rows="2" maxlength="2000"><%= editing ? application.skills : '' %></textarea></label>
  <label>Preferred duration<select name="requested_duration" required><option value="">Select a duration</option><% ['1 month','2 months','3 months','6 months','9 months','1 year','Custom duration'].forEach((value) => { %><option <%= (editing ? application.requested_duration : '') === value ? 'selected' : '' %>><%= value %></option><% }) %></select></label>
  <% if(editing && documents.length){ %><div class="span-two"><strong>Current supporting documents</strong><ul class="document-list"><% documents.forEach((document) => { %><li><a href="/documents/<%= document.id %>"><%= document.original_name %> ↓</a></li><% }) %></ul></div><% } %>
  <label>Additional CV and supporting documents<small>Existing documents will be kept. Up to 8 documents total; PDF, DOC, DOCX, JPG or PNG, maximum 5 MB each.</small><input type="file" name="documents" multiple accept=".pdf,.doc,.docx,.jpg,.jpeg,.png"></label>
  <label class="span-two">Cover letter<textarea name="cover_letter" rows="4" maxlength="8000"><%= editing ? application.cover_letter : '' %></textarea></label><label class="span-two">Why are you interested in this opportunity?<textarea name="reason" rows="3" maxlength="3000"><%= editing ? application.reason : '' %></textarea></label>
  <p class="span-two form-notice">Your documents are stored privately and can only be accessed by you and authorised administrators.</p>
  <button class="button button-primary span-two" type="submit"><%= editing ? 'Save application changes' : 'Submit application' %> <span>→</span></button>
</form></section>
<%- include('../partials/footer') %>
