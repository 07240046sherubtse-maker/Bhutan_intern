<%- include('partials/header', { title }) %>
<section class="hero hero-without-art">
  <div class="hero-copy">
    <span class="eyebrow"><span class="eyebrow-dot"></span> Your next step starts here</span>
    <h1>Find your internship.<br><span>Build your future.</span></h1>
    <p>Discover opportunities, gain practical experience and grow your skills with organisations across Bhutan.</p>
    <form class="search-panel" action="/internships" method="get">
      <label class="search-field"><span>What are you looking for?</span><input name="q" placeholder="Role, skill or company"></label>
      <label class="search-field"><span>Where?</span><input name="dzongkhag" placeholder="Dzongkhag"></label>
      <button class="button button-primary" type="submit">Explore internships <span aria-hidden="true">→</span></button>
    </form>
    <div class="hero-note"><span class="check-mark">✓</span> Verified opportunities, managed by our team</div>
  </div>
</section>
<section class="trust-strip"><span>Built for Bhutan's next generation</span><span>✦ &nbsp; Real experience</span><span>✦ &nbsp; Local opportunities</span><span>✦ &nbsp; Career confidence</span></section>
<section class="section">
  <div class="section-heading"><div><span class="eyebrow">Take the first step</span><h2>Opportunities to get you going</h2><p>Explore current internships shared and confirmed by participating organisations.</p></div><a class="text-link" href="/internships">Browse all internships <span>→</span></a></div>
  <% if (internships.length) { %><div class="card-grid">
    <% internships.forEach((internship) => { %><article class="internship-card">
      <div class="card-topline"><span class="tag"><%= internship.internship_type.replace('-', ' ') %></span><span class="card-icon">↗</span></div>
      <h3><a href="/internships/<%= internship.id %>"><%= internship.title %></a></h3><p class="company-line"><%= internship.company_name %></p>
      <div class="card-meta"><span>⌖ <%= internship.dzongkhag || 'Bhutan' %></span><span><%= internship.category %></span></div>
      <div class="card-bottom"><span><%= internship.stipend_nu ? `Nu. ${Number(internship.stipend_nu).toLocaleString("en-GB")} / month` : 'Allowance not specified' %></span><a href="/internships/<%= internship.id %>" aria-label="View <%= internship.title %>">→</a></div>
    </article><% }); %>
  </div><% } else { %><div class="empty-state"><span class="empty-icon">✦</span><h3>New opportunities are on their way</h3><p>Check back soon or browse our internship categories.</p><a class="button button-secondary" href="/internships">Browse internships</a></div><% } %>
</section>
<section class="experience-section">
  <div class="experience-copy">
    <span class="eyebrow">Learning in the workplace</span>
    <h2>Turn what you learn into real experience.</h2>
    <p>Explore opportunities where you can build practical skills, meet new teams and take your next step with confidence.</p>
    <a class="text-link" href="/internships">Find your opportunity <span>→</span></a>
  </div>
  <div class="experience-gallery" aria-label="People gaining professional experience">
    <img class="experience-photo experience-photo-main" src="/images/homepage-workplace-woman.jpg" alt="Professional carrying a laptop at the entrance to a modern workplace" loading="lazy">
    <img class="experience-photo experience-photo-secondary" src="/images/homepage-workplace-man.jpg" alt="Professional carrying a tablet through a modern office" loading="lazy">
    <span class="experience-caption">Your next step starts with experience</span>
  </div>
</section>
<section class="section category-section"><div class="section-heading"><div><span class="eyebrow">Explore your interests</span><h2>Where could you begin?</h2><p>Find practical learning across different fields.</p></div></div>
  <div class="category-grid"><% ['Information Technology','Business Administration','Accounting and Finance','Engineering','Tourism and Hospitality','Agriculture','Marketing and Sales','Education','Healthcare Administration','Construction','Customer Service','Government and Public Administration'].forEach((category,index) => { %><a class="category-item" href="/internships?category=<%= encodeURIComponent(category) %>"><span class="category-number"><%= String(index+1).padStart(2,'0') %></span><span><%= category %></span><span class="category-arrow">↗</span></a><% }) %></div>
</section>
<section class="how-section"><div class="how-inner"><div><span class="eyebrow eyebrow-light">Simple by design</span><h2>Your experience<br>starts with a search.</h2><p>From finding the right opening to tracking your application, we make the process clear at every step.</p><a class="button button-gold" href="/login">Sign in or create an account <span>→</span></a></div><div class="steps-list"><div class="step"><span>01</span><div><h3>Create your profile</h3><p>Share your interests, education and the kind of experience you want.</p></div></div><div class="step"><span>02</span><div><h3>Find your opportunity</h3><p>Explore verified internship listings and learn about each organisation.</p></div></div><div class="step"><span>03</span><div><h3>Apply and grow</h3><p>Submit your application and follow its progress from your dashboard.</p></div></div></div></div></section>
<%- include('partials/footer') %>
