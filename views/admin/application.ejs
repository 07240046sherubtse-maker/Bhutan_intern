<%- include('../partials/header', { title }) %><section class="dashboard-head"><div><a class="back-link" href="/admin/applications">← Applications</a><span class="eyebrow">Application review</span><h1><%= application.user_name %></h1><p><%= application.title %> · <%= application.company_name %></p></div><span class="status status-<%= application.status %>"><%= application.status %></span></section>
<section class="dashboard-grid"><article class="content-panel"><span class="eyebrow">Applicant details</span><h2><%= application.user_name %></h2><p><%= application.email %> · <%= application.phone %></p><dl class="facts-list"><div><dt>Education</dt><dd><%= application.education || '—' %></dd></div><div><dt>Institution</dt><dd><%= application.institution || '—' %></dd></div><div><dt>Field of study</dt><dd><%= application.field_of_study || '—' %></dd></div><div><dt>Location</dt><dd><%= application.dzongkhag || '—' %></dd></div><div><dt>Preferred date</dt><dd><%= application.preferred_start_date ? new Date(application.preferred_start_date).toLocaleDateString("en-GB") : '—' %></dd></div><div><dt>Requested duration</dt><dd><%= application.requested_duration || '—' %></dd></div></dl><h3>Experience</h3><p><%= application.experience || '—' %></p><h3>Skills</h3><p><%= application.skills || '—' %></p><h3>Cover letter</h3><p class="preserve-lines"><%= application.cover_letter || '—' %></p><h3>Reason for applying</h3><p class="preserve-lines"><%= application.reason || '—' %></p></article>
<aside class="content-panel"><span class="eyebrow">Decision</span><form method="post" action="/admin/applications/<%= application.id %>/status" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Status<select name="status"><% ['pending','approved','declined'].forEach((value)=>{ %><option value="<%= value %>" <%= application.status===value?'selected':'' %>><%= value %></option><% }) %></select></label><label>Administrative note / feedback<textarea name="admin_notes" rows="5" maxlength="5000"><%= application.admin_notes || '' %></textarea></label><p class="form-notice">Approval creates an internship record; it does not mark the internship as started.</p><button class="button button-primary">Save decision</button></form>
  <hr><h2>Documents</h2><% if(documents.length){ %><ul class="document-list"><% documents.forEach((doc)=>{ %><li><a href="/admin/documents/<%= doc.id %>"><%= doc.original_name %> ↓</a><small><%= new Date(doc.uploaded_at).toLocaleDateString("en-GB") %></small></li><% }) %></ul><% }else{ %><p class="muted">No documents uploaded.</p><% } %></aside></section>
<section class="content-panel history-panel"><h2>Status history</h2><% if(history.length){ %><div class="history-list"><% history.forEach((item)=>{ %><div><span class="history-dot"></span><p><strong><%= item.new_status %></strong> · <%= item.changed_by_name %><small><%= new Date(item.changed_at).toLocaleString("en-GB") %></small><% if(item.note){ %><small><%= item.note %></small><% } %></p></div><% }) %></div><% }else{ %><p class="muted">No status changes recorded.</p><% } %></section><%- include('../partials/footer') %>
