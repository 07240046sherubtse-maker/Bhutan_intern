<%- include('../partials/header', { title }) %><section class="dashboard-head"><div><span class="eyebrow">Availability and listings</span><h1>Manage internships</h1><p>Publish only opportunities confirmed by the host organisation.</p></div><a class="button button-primary" href="/admin/internships/new">Add internship <span>+</span></a></section>
<section class="content-panel"><% if(internships.length){ %><div class="table-wrap"><table><thead><tr><th>Opportunity</th><th>Organisation</th><th>Category / type</th><th>Status</th><th>Update status</th></tr></thead><tbody><% internships.forEach((internship) => { %><tr><td><strong><%= internship.title %></strong><small class="table-note"><%= internship.dzongkhag || 'Bhutan' %> · <%= internship.positions %> positions</small><small class="table-note">Confirmed: <%= internship.last_confirmed_at ? new Date(internship.last_confirmed_at).toLocaleDateString("en-GB") : 'Not recorded' %></small><a class="text-link" href="/admin/internships/<%= internship.id %>/edit">Edit details</a></td><td><%= internship.company_name %></td><td><%= internship.category %><small class="table-note"><%= internship.internship_type %></small></td><td><span class="status status-<%= internship.status %>"><%= internship.status.replace('_',' ') %></span></td><td><form method="post" action="/admin/internships/<%= internship.id %>/status" class="inline-status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="status"><% ['draft','pending_confirmation','published','paused','filled','expired','archived'].forEach((value)=>{ %><option value="<%= value %>" <%= internship.status===value?'selected':'' %>><%= value.replace('_',' ') %></option><% }) %></select><label class="inline-check"><input type="checkbox" name="availability_confirmed" value="true"> Company confirmed availability</label><button class="button button-small button-quiet">Save</button></form></td></tr><% }) %></tbody></table></div><% }else{ %><div class="empty-state"><h2>No internship listings</h2><p>Add an opportunity confirmed by a participating company.</p><a class="button button-primary" href="/admin/internships/new">Add internship</a></div><% } %></section><%- include('../partials/footer') %>
