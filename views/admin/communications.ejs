<%- include('../partials/header', { title }) %><section class="dashboard-head"><div><a class="back-link" href="/admin/companies">← Companies</a><span class="eyebrow">Partnership follow-up</span><h1><%= company.name %></h1><p>Record confirmation and follow-up details. No reply alone does not mark a listing filled.</p></div></section>
<section class="dashboard-grid"><form class="content-panel form-grid" method="post" enctype="multipart/form-data" action="/admin/companies/<%= company.id %>/communications"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h2 class="span-two">Add a communication record</h2><label>Contact date<input class="date-dmy" type="text" name="contact_date" placeholder="DD/MM/YYYY" inputmode="numeric" pattern="\d{2}/\d{2}/\d{4}" aria-label="Contact date (DD/MM/YYYY)"></label><label>Contact method<select name="method"><option value="phone">Phone</option><option value="email">Email</option><option value="in_person">In person</option><option value="other">Other</option></select></label><label>Person contacted<input name="person_contacted" maxlength="200"></label><label>Next follow-up date<input class="date-dmy" type="text" name="follow_up_date" placeholder="DD/MM/YYYY" inputmode="numeric" pattern="\d{2}/\d{2}/\d{4}" aria-label="Next follow-up date (DD/MM/YYYY)"></label><label class="span-two">Information received<textarea name="details" rows="3" required maxlength="10000"></textarea></label><label class="span-two">Confirmed opportunities<textarea name="confirmed_opportunities" rows="2" maxlength="3000"></textarea></label><label>Available positions<input type="number" name="available_positions" min="0"></label><label>Last availability confirmation date<input class="date-dmy" type="text" name="confirmation_date" placeholder="DD/MM/YYYY" inputmode="numeric" pattern="\d{2}/\d{2}/\d{4}" aria-label="Last availability confirmation date (DD/MM/YYYY)"></label><label class="span-two">Supporting partnership / communication document<input name="supporting_document" type="file" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png"><small>PDF, DOC, DOCX, JPG or PNG, up to 5 MB.</small></label><button class="button button-primary span-two">Save communication</button></form>
<aside class="content-panel"><span class="eyebrow">Contact information</span><h2><%= company.name %></h2><p><%= company.email || 'No email recorded' %></p><p><%= company.phone || 'No phone recorded' %></p><p>Last confirmation: <%= company.last_confirmation_date ? formatDate(company.last_confirmation_date) : 'Not recorded' %></p></aside></section>
<section class="content-panel"><div class="panel-heading"><h2>Communication history</h2></div><% if(logs.length){ %><div class="table-wrap"><table><thead><tr><th>Date</th><th>Method / contact</th><th>Information</th><th>Follow-up</th></tr></thead><tbody><% logs.forEach((log) => { %><tr><td><%= formatDate(log.contact_date) %></td><td><%= log.method %><small class="table-note"><%= log.person_contacted || '—' %></small></td><td><%= log.details %><% if(log.confirmed_opportunities){ %><small class="table-note"><%= log.confirmed_opportunities %></small><% } %></td><td><%= log.follow_up_date ? formatDate(log.follow_up_date) : '—' %></td></tr><% }) %></tbody></table></div><% }else{ %><div class="empty-inline"><p>No communication recorded yet.</p></div><% } %>
  <h2>Private company documents</h2><% if(documents.length){ %><ul class="document-list"><% documents.forEach((doc)=>{ %><li><a href="/admin/company-documents/<%= doc.id %>"><%= doc.original_name %> ↓</a><small><%= formatDate(doc.uploaded_at) %></small></li><% }) %></ul><% }else{ %><p class="muted">No supporting documents uploaded.</p><% } %>
</section><%- include('../partials/footer') %>
