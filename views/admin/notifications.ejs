<%- include('../partials/header', { title }) %><section class="dashboard-head"><div><span class="eyebrow">Platform updates</span><h1>Administrator notifications</h1><p>New registrations, applications and operational reminders.</p></div></section><section class="content-panel"><% if(notifications.length){ %><div class="notification-list"><% notifications.forEach((item)=>{ %><article class="notification-item <%= item.read_at?'':'unread' %>"><div><p><%= item.message %></p><small><%= new Date(item.created_at).toLocaleString("en-GB") %></small></div><div class="notification-actions"><% if(item.href){ %><a class="text-link" href="<%= item.href %>">Open →</a><% } %><% if(!item.read_at){ %><form method="post" action="/admin/notifications/<%= item.id %>/read"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-small button-quiet">Mark read</button></form><% } %></div></article><% }) %></div><% }else{ %><div class="empty-inline"><p>No notifications yet.</p></div><% } %></section><%- include('../partials/footer') %>
