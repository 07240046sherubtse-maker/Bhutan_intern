<%- include('../partials/header', { title }) %><section class="dashboard-head"><div><span class="eyebrow">Internship records</span><h1>Extension requests</h1><p>Confirm with the host organisation before approving an extension.</p></div></section>
<section class="content-panel"><% if(extensions.length){ %><div class="table-wrap"><table><thead><tr><th>Intern</th><th>Internship</th><th>Current end</th><th>Request</th><th>Status / decision</th></tr></thead><tbody><% extensions.forEach((item)=>{ %><tr><td><%= item.user_name %></td><td><%= item.internship_title %></td><td><%= item.current_end_date ? new Date(item.current_end_date).toLocaleDateString("en-GB") : '—' %></td><td><strong><%= item.additional_duration %></strong><small class="table-note">New end: <%= new Date(item.proposed_end_date).toLocaleDateString("en-GB") %></small><small class="table-note"><%= item.reason %></small></td><td><% if(item.status==='pending'){ %><form method="post" action="/admin/extensions/<%= item.id %>/status" class="form-stack compact-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="status"><option value="approved">Approve</option><option value="declined">Decline</option></select><label class="inline-check"><input type="checkbox" name="company_confirmed" value="true"> Host company confirmed</label><input name="admin_comment" placeholder="Comment (optional)" maxlength="2000"><button class="button button-small button-primary">Record decision</button></form><% }else{ %><span class="status status-<%= item.status %>"><%= item.status %></span><small class="table-note"><%= item.admin_comment %></small><% } %></td></tr><% }) %></tbody></table></div><% }else{ %><div class="empty-inline"><p>No extension requests.</p></div><% } %></section><%- include('../partials/footer') %>
