<%- include('../partials/header', { title }) %><section class="dashboard-head"><div><span class="eyebrow">Placement records</span><h1>Manage interns</h1><p>Confirm the actual start date separately after the host company confirms placement.</p></div></section>
<section class="content-panel"><% if(records.length){ %><div class="table-wrap"><table><thead><tr><th>Intern</th><th>Organisation / opportunity</th><th>Status</th><th>Start</th><th>End date</th><th>Action</th></tr></thead><tbody><% records.forEach((record)=>{ %><tr><td><strong><%= record.user_name %></strong><small class="table-note"><%= record.email %></small></td><td><%= record.company_name %><small class="table-note"><%= record.internship_title %></small></td><td><span class="status status-<%= record.status %>"><%= record.status %></span></td><td><%= record.actual_start_date ? formatDate(record.actual_start_date) : 'Not confirmed' %></td><td><%= record.current_end_date ? formatDate(record.current_end_date) : 'Not set' %></td><td><% if(record.status==='upcoming'){ %><form method="post" action="/admin/interns/<%= record.id %>/start" class="form-stack compact-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input class="date-dmy" type="text" name="actual_start_date" required placeholder="DD/MM/YYYY" inputmode="numeric" pattern="\d{2}/\d{2}/\d{4}" aria-label="Actual start date (DD/MM/YYYY)"><button class="button button-small button-primary">Confirm start</button></form><% }else if(record.status==='active'){ %><form method="post" action="/admin/interns/<%= record.id %>/status" class="inline-status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="status"><option value="completed">Completed</option><option value="ended">Ended</option></select><button class="button button-small button-quiet">Update</button></form><% }else{ %><span class="muted">—</span><% } %></td></tr><% }) %></tbody></table></div><% }else{ %><div class="empty-inline"><p>No approved internship records.</p></div><% } %></section><%- include('../partials/footer') %>
