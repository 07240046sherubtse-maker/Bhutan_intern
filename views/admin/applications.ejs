<%- include('../partials/header', { title }) %><section class="dashboard-head"><div><span class="eyebrow">Applicant review</span><h1>Manage applications</h1><p>Review applications and keep a clear status history.</p></div><a href="/admin/applications" class="button button-secondary">All applications</a></section>
<section class="content-panel"><nav class="filter-links"><% [['','All'],['pending','Pending'],['approved','Approved'],['declined','Declined'],['cancelled','Cancelled']].forEach(([value,label])=>{ %><a class="<%= status===value?'active':'' %>" href="/admin/applications<%= value ? '?status='+value : '' %>"><%= label %></a><% }) %></nav>
  <% if(applications.length){ %><div class="table-wrap"><table><thead><tr><th>Applicant</th><th>Opportunity</th><th>Organisation</th><th>Submitted</th><th>Status</th><th></th></tr></thead><tbody><% applications.forEach((app)=>{ %><tr><td><strong><%= app.user_name %></strong><small class="table-note"><%= app.email %></small></td><td><%= app.internship_title %></td><td><%= app.company_name %></td><td><%= new Date(app.submitted_at).toLocaleDateString("en-GB") %></td><td><span class="status status-<%= app.status %>"><%= app.status %></span></td><td><a class="button button-small button-quiet" href="/admin/applications/<%= app.id %>">Review</a></td></tr><% }) %></tbody></table></div><% }else{ %><div class="empty-inline"><p>No applications found.</p></div><% } %>
</section><%- include('../partials/footer') %>
