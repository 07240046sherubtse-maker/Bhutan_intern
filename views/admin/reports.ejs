<%- include('../partials/header', { title }) %><section class="dashboard-head"><div><span class="eyebrow">Platform insights</span><h1>Reports and analytics</h1><p>Overview of application activity and internship categories.</p></div><div class="button-row"><a class="button button-secondary" href="/admin/reports/summary.pdf">Download PDF report</a><a class="button button-secondary" href="/admin/reports/applications.csv">Export applications CSV ↓</a></div></section><div class="report-grid"><section class="content-panel"><h2>Applications by status</h2><% if(applications.length){ %><div class="report-list"><% applications.forEach((item)=>{ %><div><span><%= item.status %></span><strong><%= item.count %></strong></div><% }) %></div><% }else{ %><p class="muted">No application data yet.</p><% } %></section><section class="content-panel"><h2>Internships by category</h2><% if(categories.length){ %><div class="report-list"><% categories.forEach((item)=>{ %><div><span><%= item.category %></span><strong><%= item.count %></strong></div><% }) %></div><% }else{ %><p class="muted">No internship data yet.</p><% } %></section><section class="content-panel"><h2>Applications by Dzongkhag</h2><% if(regions.length){ %><div class="report-list"><% regions.forEach((item)=>{ %><div><span><%= item.dzongkhag %></span><strong><%= item.count %></strong></div><% }) %></div><% }else{ %><p class="muted">No application data yet.</p><% } %></section></div><%- include('../partials/footer') %>
