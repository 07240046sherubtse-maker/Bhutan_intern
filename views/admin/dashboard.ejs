<%- include('../partials/header', { title }) %>
<section class="dashboard-head"><div><span class="eyebrow">Platform overview</span><h1>Good day, <%= currentUser.name.split(' ')[0] %>.</h1><p>Here's what's happening across Bhutan InternshipLink.</p></div><a class="button button-primary" href="/admin/internships/new">Add opportunity <span>+</span></a></section>
<section class="stats-grid admin-stats"><article class="stat-card"><span>Registered seekers</span><strong><%= stats.users.total %></strong><small>Active user accounts</small></article><article class="stat-card"><span>Total companies</span><strong><%= stats.companies.total %></strong><small><%= stats.companies.verified %> verified</small></article><article class="stat-card"><span>Active partners</span><strong><%= stats.companies.active %></strong><small><%= stats.companies.inactive %> inactive</small></article><article class="stat-card"><span>Published internships</span><strong><%= stats.internships.published %></strong><small><%= stats.internships.total %> total listings</small></article><article class="stat-card"><span>Pending applications</span><strong><%= stats.applications.pending %></strong><small><%= stats.applications.approved %> approved · <%= stats.applications.declined %> declined · <%= stats.applications.cancelled %> cancelled</small></article><article class="stat-card"><span>Active interns</span><strong><%= stats.records.total %></strong><small>Actual starts confirmed</small></article><article class="stat-card"><span>Pending extensions</span><strong><%= stats.extensions.total %></strong><small>Awaiting decision</small></article><article class="stat-card"><span>Filled listings</span><strong><%= stats.internships.filled %></strong><small>Historic records retained</small></article></section>
<section class="dashboard-grid"><div class="content-panel"><div class="panel-heading"><div><span class="eyebrow">Review and follow up</span><h2>Companies to contact</h2></div><a class="text-link" href="/admin/companies">All companies →</a></div>
  <% if(followups.length){ %><div class="table-wrap"><table><thead><tr><th>Organisation</th><th>Follow-up due</th><th></th></tr></thead><tbody><% followups.forEach((item) => { %><tr><td><%= item.name %></td><td><%= new Date(item.follow_up_date).toLocaleDateString("en-GB") %></td><td><a class="text-link" href="/admin/companies/<%= item.id %>/communications">View log</a></td></tr><% }) %></tbody></table></div><% }else{ %><div class="empty-inline"><p>No company follow-ups are due.</p></div><% } %>
</div><aside class="content-panel"><span class="eyebrow">Administration</span><h2>Quick links</h2><div class="quick-links"><a href="/admin/applications">Review applications <span>→</span></a><a href="/admin/internships">Manage internships <span>→</span></a><a href="/admin/extensions">Extension requests <span>→</span></a><a href="/admin/reports">Reports and analytics <span>→</span></a><a href="/admin/profile">Administrator profile <span>→</span></a><a href="/admin/settings">Account settings <span>→</span></a></div></aside></section>
<%- include('../partials/footer') %>
