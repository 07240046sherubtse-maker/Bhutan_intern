<%- include('../partials/header', { title }) %><section class="dashboard-head"><div><span class="eyebrow">Trusted partnerships</span><h1>Manage companies</h1><p>Only confirmed, active partners and their published opportunities appear publicly.</p></div><a class="button button-primary" href="/admin/companies/new">Add company <span>+</span></a></section>
<section class="content-panel"><% if(companies.length){ %><div class="table-wrap"><table><thead><tr><th>Organisation</th><th>Industry / location</th><th>Verification</th><th>Partnership</th><th>Actions</th></tr></thead><tbody><% companies.forEach((company) => { %><tr><td><strong><%= company.name %></strong><small class="table-note"><%= company.email || 'No public email' %></small></td><td><%= company.industry || '—' %><small class="table-note"><%= company.dzongkhag || 'Bhutan' %></small></td><td><span class="status status-<%= company.verification_status %>"><%= company.verification_status %></span></td><td><span class="status status-<%= company.partnership_status %>"><%= company.partnership_status %></span></td><td><div class="row-actions"><a class="text-link" href="/admin/companies/<%= company.id %>/edit">Edit details</a><a class="text-link" href="/admin/companies/<%= company.id %>/communications">Communication log</a><form method="post" action="/admin/companies/<%= company.id %>/status" class="inline-status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="verification_status" aria-label="Verification status"><% ['pending','verified','rejected'].forEach((value)=>{ %><option value="<%= value %>" <%= company.verification_status===value?'selected':'' %>><%= value %></option><% }) %></select><select name="partnership_status" aria-label="Partnership status"><% ['active','inactive','archived'].forEach((value)=>{ %><option value="<%= value %>" <%= company.partnership_status===value?'selected':'' %>><%= value %></option><% }) %></select><button class="button button-small button-quiet">Save</button></form></div></td></tr><% }) %></tbody></table></div><% }else{ %><div class="empty-state"><h2>No organisations added</h2><p>Add a company after confirming its participation.</p><a class="button button-primary" href="/admin/companies/new">Add a company</a></div><% } %></section><%- include('../partials/footer') %>
