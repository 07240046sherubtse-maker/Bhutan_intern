<%- include('../partials/header', { title }) %><section class="dashboard-head"><div><span class="eyebrow">Administrator account</span><h1>Admin profile</h1><p>Update your account contact details.</p></div></section>
<form class="content-panel form-grid profile-form" method="post" action="/admin/profile"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Full name<input name="name" value="<%= profile.name %>" required maxlength="120"></label><label>Email<input name="email" type="email" value="<%= profile.email %>" required maxlength="254"><small>Changing email requires your current password.</small></label><label>Phone<input name="phone" type="tel" value="<%= profile.phone %>" required maxlength="40"></label><label>Current password (only required to change email)<input type="password" name="current_password" autocomplete="current-password"></label><button class="button button-primary span-two">Save profile</button></form><%- include('../partials/footer') %>
