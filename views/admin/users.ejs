<%- include('../partials/header', { title }) %><section class="dashboard-head"><div><span class="eyebrow">Accounts</span><h1>Manage users</h1><p>Review registered internship seekers and account access.</p></div></section><section class="content-panel"><% if(users.length){ %><div class="table-wrap"><table><thead><tr><th>User</th><th>Location</th><th>Education</th><th>Joined</th><th>Access</th></tr></thead><tbody><% users.forEach((user)=>{ %><tr><td><strong><%= user.name %></strong><small class="table-note"><%= user.email %> · <%= user.phone %></small></td><td><%= user.dzongkhag || '—' %></td><td><%= user.education || '—' %></td><td><%= new Date(user.created_at).toLocaleDateString("en-GB") %></td><td><form method="post" action="/admin/users/<%= user.id %>/status" class="inline-status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="is_active"><option value="true" <%= user.is_active?'selected':'' %>>Active</option><option value="false" <%= user.is_active?'':'selected' %>>Suspended</option></select><button class="button button-small button-quiet">Save</button></form></td></tr><% }) %></tbody></table></div><% }else{ %><div class="empty-inline"><p>No user accounts yet.</p></div><% } %></section><%- include('../partials/footer') %>
