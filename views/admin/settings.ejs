<%- include('../partials/header', { title }) %><section class="dashboard-head"><div><span class="eyebrow">Secure access</span><h1>Administrator settings</h1><p>Use a unique administrator password of at least 12 characters.</p></div></section>
<form class="content-panel form-stack settings-form" method="post" action="/admin/settings/password"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h2>Change password</h2><label>Current password<input type="password" name="current_password" autocomplete="current-password" required></label><label>New password<input type="password" name="new_password" autocomplete="new-password" minlength="12" maxlength="128" required></label><label>Confirm new password<input type="password" name="confirm_password" autocomplete="new-password" minlength="12" maxlength="128" required></label><button class="button button-primary">Update password</button></form><%- include('../partials/footer') %>
