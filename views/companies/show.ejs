<%- include('../partials/header', { title }) %>
<section class="section company-profile"><a href="/companies" class="back-link">← All companies</a><% if(company.logo_stored_name){ %><img class="company-logo company-logo-large" src="/companies/<%= company.id %>/logo" alt="<%= company.name %> logo"><% }else{ %><span class="company-monogram"><%= company.name.slice(0,1).toUpperCase() %></span><% } %><span class="verified-label">✓ Verified partner</span><h1><%= company.name %></h1><p class="company-line"><%= company.industry %> · <%= company.dzongkhag %></p><p><%= company.description %></p><% if(company.website){ %><a class="text-link" href="<%= company.website %>" target="_blank" rel="noopener noreferrer">Visit official website ↗</a><% } %></section>
<section class="section"><div class="section-heading"><div><span class="eyebrow">Current openings</span><h2>Internship opportunities</h2></div></div>
  <% if(internships.length){ %><div class="card-grid"><% internships.forEach((internship) => { %><article class="internship-card"><span class="tag"><%= internship.internship_type %></span><h3><a href="/internships/<%= internship.id %>"><%= internship.title %></a></h3><p><%= internship.category %> · <%= internship.dzongkhag || company.dzongkhag %></p><a class="text-link" href="/internships/<%= internship.id %>">View opportunity →</a></article><% }) %></div><% }else{ %><div class="empty-state"><p>No confirmed openings at the moment.</p></div><% } %>
</section>
<%- include('../partials/footer') %>
