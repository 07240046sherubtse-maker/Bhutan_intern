<%- include('../partials/header', { title }) %>
<section class="page-hero companies-page-hero"><span class="eyebrow">People and places to grow</span><h1>Explore Bhutanese<br><span>organisations.</span></h1><p>Meet the verified, active organisations participating in InternshipLink.</p></section>
<section class="section"><% if(companies.length){ %><div class="company-grid"><% companies.forEach((company) => { %><article class="company-card"><% if(company.logo_stored_name){ %><img class="company-logo" src="/companies/<%= company.id %>/logo" alt="<%= company.name %> logo"><% }else{ %><span class="company-monogram"><%= company.name.slice(0,1).toUpperCase() %></span><% } %><span class="verified-label">✓ Verified partner</span><h2><a href="/companies/<%= company.id %>"><%= company.name %></a></h2><p class="company-line"><%= company.industry || 'Bhutanese organisation' %> · <%= company.dzongkhag || 'Bhutan' %></p><p><%= company.description || 'Explore current opportunities with this organisation.' %></p><a class="text-link" href="/companies/<%= company.id %>"><%= company.internship_count %> current opportunities <span>→</span></a></article><% }) %></div><% }else{ %><div class="empty-state"><span class="empty-icon">✦</span><h3>We're building trusted partnerships</h3><p>Organisations will appear here only after their participation has been confirmed.</p></div><% } %></section>
<%- include('../partials/footer') %>
